+func TestGoogleAdsCloudProjectAuthWithoutDeveloperToken(t *testing.T) {
+	for _, hook := range []func() string{nil, func() string { return "" }} {
+		calls := 0
+		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			calls++
+			if _, exists := r.Header["Developer-Token"]; exists {
+				t.Error("deprecated token header must be omitted")
+			}
+			if r.Header.Get("Authorization") != "Bearer OAUTH-ONLY" {
+				t.Error("OAuth bearer missing")
+			}
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(`{"results":[]}`))
+		}))
+		adapter := NewAdapter(hook)
+		adapter.BaseURL = srv.URL
+		resp, err := adapter.Execute(context.Background(),
+			&dispatch.Invocation{Args: map[string]any{"customerId": "1234567890", "keywords": []any{"signature scan"}}},
+			rvFor("generateKeywordIdeas"), &dispatch.Credentials{Token: "OAUTH-ONLY"})
+		srv.Close()
+		if err != nil || resp == nil || resp.StatusCode != 200 || calls != 1 {
+			t.Fatalf("token-free call failed: %v; calls=%d", err, calls)
+		}
 	}
 }
 
